# ============================================
# CONFIGURAÇÃO DO PROJETO - PODCAST Q&A
# ============================================
# Copie este arquivo para .env e preencha:
#   cp .env.example .env

# API Key do Groq (grátis em https://console.groq.com)
GROQ_API_KEY=gsk_sua_chave_aqui

# Modelo padrão do Groq
GROQ_MODEL=llama-3.3-70b-versatile

# Modelo barato para routing (perguntas simples)
GROQ_MODEL_CHEAP=llama-3.1-8b-instant
